{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "name": "Atmos",
  "version": "1.0.0",
  "description": "Modular color system for the Air Pollution Dashboard. Every color used anywhere in the workbook is derived from this file. Edit a token here and re-run theme/apply_theme.py to re-skin the entire workbook.",

  "color": {
    "surface": {
      "canvas": "#EEF2F7",
      "card": "#FFFFFF",
      "header": "#132A43"
    },

    "ink": {
      "heading": "#132A43",
      "body": "#3E5166",
      "muted": "#6C7F94",
      "inverse": "#FFFFFF",
      "inverseMuted": "#A9BDD4"
    },

    "line": {
      "hairline": "#D9E2EC",
      "headerRule": "#2C5375"
    },

    "brand": {
      "primary": "#1B6CA8",
      "primaryDark": "#14507E"
    },

    "series": {
      "prior": "#A3B7CB",
      "current": "#1B6CA8"
    },

    "status": {
      "good": "#4E9E70",
      "moderate": "#E3A93D",
      "bad": "#CF5A5A"
    },

    "categorical": {
      "blue": "#1B6CA8",
      "amber": "#E3A93D",
      "green": "#4E9E70",
      "rose": "#C9605E",
      "purple": "#7E6DAE",
      "teal": "#45A0A4",
      "olive": "#96A054",
      "brown": "#A9805B"
