      "body": "#42566C",
      "muted": "#75879D",
      "inverse": "#FFFFFF",
      "inverseMuted": "#B9C8DB"
    },

    "line": {
      "hairline": "#E3EAF2",
      "headerRule": "#33517A"
    },

    "brand": {
      "primary": "#2C7DA0",
      "primaryDark": "#1F5F80"
    },

    "series": {
      "prior": "#B3C5D6",
      "current": "#2C7DA0"
    },

    "status": {
      "good": "#4E9D77",
      "moderate": "#E5AF4E",
      "bad": "#D26A66"
    },

    "categorical": {
      "blue": "#2C7DA0",
      "amber": "#E5AF4E",
