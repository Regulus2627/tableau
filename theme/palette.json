    "pollutant": {
      "pm2_5": "#C9605E",
      "pm10": "#E3A93D",
      "co": "#1B6CA8",
      "no2": "#4E9E70",
      "o3": "#7E6DAE",
      "so2": "#45A0A4",
      "nh3": "#96A054",
      "no": "#A9805B"
    },

    "aqiCategory": {
      "Low AQI": "#4E9E70",
      "Moderate AQI": "#E3A93D",
      "High AQI": "#CF5A5A"
    },

    "exceedanceFlag": {
      "Normal": "#4E9E70",
      "High": "#CF5A5A"
    },

    "year": {
      "2021": "#A3B7CB",
      "2022": "#1B6CA8"
    }
  },

  "type": {
    "family": "Tableau",
    "familyBold": "Tableau Bold",
    "dashboardTitle": 22,
    "dashboardSubtitle": 10,
    "chartTitle": 12,
    "kpiLabel": 10,
