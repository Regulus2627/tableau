      "Moderate AQI": "#E5AF4E",
      "High AQI": "#D26A66"
    },

    "exceedanceFlag": {
      "Normal": "#4E9D77",
      "High": "#D26A66"
    },

    "year": {
      "2021": "#B3C5D6",
      "2022": "#2C7DA0"
    }
  },

  "type": {
    "family": "Tableau",
    "familyBold": "Tableau Bold",
